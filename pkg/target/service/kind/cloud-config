#cloud-config
ntp:
  enabled: true
  servers:
    - 0.pool.ntp.org
    - 1.pool.ntp.org
    - 2.pool.ntp.org
    - 3.pool.ntp.org
  config:
    service_name: chronyd.service
    check_exe: chronyd
write_files:
- content: |
    # kind-config.yaml
    kind: Cluster
    apiVersion: kind.x-k8s.io/v1alpha4
    kubeadmConfigPatches:
    - |
      kind: ClusterConfiguration
      apiServer:
        certSANs:
        - "{{ .PublicIP }}"
    - |
      kind: InitConfiguration
      nodeRegistration:
        kubeletExtraArgs:
          node-labels: "ingress-ready=true"
          system-reserved: memory=8Gi
    nodes:
    - role: control-plane
      extraPortMappings:
      - containerPort: 6443
        hostPort: 6443
        protocol: TCP
      - containerPort: 30010
        hostPort: 8888
        protocol: TCP
      - containerPort: 30011
        hostPort: 9443
        protocol: TCP{{- range .ExtraPortMappings }}
      - containerPort: {{ .ContainerPort }}
        hostPort: {{ .HostPort }}
        protocol: {{ .Protocol }}{{- end }}
  # owner: {{ .Username }}
  path: /root/kind-config.yaml
  permissions: '0644'
runcmd:  
  - dnf install -y podman kubectl
  - sysctl fs.inotify.max_user_watches=524288
  - sysctl fs.inotify.max_user_instances=512
  - curl -Lo /usr/local/bin/kind https://github.com/kubernetes-sigs/kind/releases/download/{{ .KindVersion }}/kind-linux-{{ .Arch }}
  - chmod +x /usr/local/bin/kind
  - kind create cluster --name kind-mapt --config /root/kind-config.yaml --image {{ .KindImage }}
  - podman update --pids-limit 4096 kind-mapt-control-plane
    # Validate cluster before export the final Kubeconfig
  - cmdKubeconfig="kind get kubeconfig --name kind-mapt > kubeconfig"
  - cmdCheckCluster="kubectl --request-timeout=3s --insecure-skip-tls-verify --kubeconfig kubeconfig get node >/dev/null 2>&1"
  - until eval $cmdCheckCluster; do eval $cmdKubeconfig; done
    # Verify control-plane stability before exporting the kubeconfig.
    # The basic API check above only confirms the API server accepts a
    # single request. Control-plane pods may still restart during the
    # next 30-60 seconds due to initial resource contention. Downstream
    # consumers that run post-actions immediately (e.g. control-plane
    # hardening) can trigger cascading failures during this window.
    # This block waits for all four control-plane components to reach
    # Running+Ready, the kubelet lease to exist, and the default
    # ServiceAccount to be created (SA controller health check).
  - |
    #!/bin/bash
    set -e
    export KUBECONFIG=/root/kubeconfig
    MAX_WAIT=300
    START=$SECONDS
    echo "Waiting for control-plane pods to reach Ready state..."
    while true; do
      ELAPSED=$((SECONDS - START))
      if [ "$ELAPSED" -gt "$MAX_WAIT" ]; then
        echo "ERROR: control-plane readiness timeout after ${MAX_WAIT}s"
        exit 1
      fi
      ALL_READY=true
      for COMPONENT in kube-apiserver kube-controller-manager kube-scheduler etcd; do
        LABEL="component=${COMPONENT}"
        PHASE=$(kubectl get pods -n kube-system -l "${LABEL}" \
          -o jsonpath='{.items[0].status.phase}' 2>/dev/null || echo "Unknown")
        READY=$(kubectl get pods -n kube-system -l "${LABEL}" \
          -o jsonpath='{.items[0].status.containerStatuses[0].ready}' 2>/dev/null || echo "false")
        if [ "$PHASE" != "Running" ] || [ "$READY" != "true" ]; then
          ALL_READY=false
          break
        fi
      done
      if [ "$ALL_READY" = "true" ]; then
        echo "All control-plane pods are Ready ($((SECONDS - START))s)"
        break
      fi
      sleep 2
    done
    echo "Waiting for kubelet lease..."
    while true; do
      ELAPSED=$((SECONDS - START))
      if [ "$ELAPSED" -gt "$MAX_WAIT" ]; then
        echo "ERROR: kubelet lease timeout after ${MAX_WAIT}s"
        exit 1
      fi
      if kubectl get lease -n kube-node-lease -o name 2>/dev/null | grep -q lease; then
        echo "Kubelet lease exists ($((SECONDS - START))s)"
        break
      fi
      sleep 2
    done
    echo "Waiting for default ServiceAccount..."
    while true; do
      ELAPSED=$((SECONDS - START))
      if [ "$ELAPSED" -gt "$MAX_WAIT" ]; then
        echo "ERROR: ServiceAccount controller timeout after ${MAX_WAIT}s"
        exit 1
      fi
      if kubectl get serviceaccount default -n default 2>/dev/null | grep -q default; then
        echo "Default ServiceAccount exists ($((SECONDS - START))s)"
        break
      fi
      sleep 2
    done
    echo "Verifying API server consistency..."
    for i in 1 2 3; do
      if ! kubectl get namespaces --request-timeout=5s >/dev/null 2>&1; then
        echo "ERROR: API server consistency check failed on attempt $i"
        exit 1
      fi
    done
    echo "Control-plane fully stable ($((SECONDS - START))s)"
  - kind get kubeconfig --name kind-mapt > /home/{{ .Username }}/kubeconfig  
