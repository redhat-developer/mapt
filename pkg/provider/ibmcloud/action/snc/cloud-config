#cloud-config
runcmd:
  - mount -o remount,rw /sysroot
  - xfs_growfs /sysroot
  - systemctl enable --now kubelet
  - echo "{{ .PublicIP }}" > /opt/crc/eip
  - chmod 0644 /opt/crc/eip
write_files:
- path: /home/{{ .Username }}/.ssh/authorized_keys
  content: {{ .PubKey }}
  owner: {{ .Username }}
  permissions: '0600'
- path: /opt/crc/id_rsa.pub
  content: {{ .PubKey }}
  owner: root:root
  permissions: '0644'
- encoding: b64
  content: {{ .PullSecretB64 }}
  owner: root:root
  path: /opt/crc/pull-secret
  permissions: '0644'
- path: /opt/crc/pass_kubeadmin
  content: {{ .KubeAdminPassword }}
  owner: root:root
  permissions: '0644'
- path: /opt/crc/pass_developer
  content: {{ .DeveloperPassword }}
  owner: root:root
  permissions: '0644'
- content: |
      CRC_SELF_SUFFICIENT=1
      CRC_NETWORK_MODE_USER=0
  owner: root:root
  path: /etc/sysconfig/crc-env
  permissions: '0644'
