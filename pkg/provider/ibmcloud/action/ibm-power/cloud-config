#cloud-config
write_files:
  - path: /usr/local/bin/mount-data-home.sh
    permissions: '0700'
    owner: root:root
    content: |
      #!/bin/bash
      set -euo pipefail
      # Set only when this run creates the filesystem. Later cloud-init steps
      # use it to tell a fresh volume from an adopted (or drifted) layout.
      FRESH_FS=0
      # Reset authorization belongs to this run, not an earlier service start.
      rm -f /run/mount-data-home-fresh
      mkdir -p /var/lib/containers/storage
      if mountpoint -q /home; then
        mkdir -p /home/containers/storage
      else
        systemctl start multipathd 2>/dev/null || true
        DATA_DEV=""
        ATTEMPTS=0
        MAX_ATTEMPTS=90
        while [ $ATTEMPTS -lt $MAX_ATTEMPTS ]; do
          DATA_DEV=$(lsblk -rnpo NAME,TYPE | awk '$2=="mpath"{mpath[$1]=1} $2=="part"{p=$1; sub(/p?[0-9]+$/,"",p); has_part[p]=1} END{for(d in mpath) if(!has_part[d]&&d!~/control/) print d}' | head -1)
          [ -n "$DATA_DEV" ] && break
          udevadm trigger --subsystem-match=block 2>/dev/null || true
          udevadm settle 2>/dev/null || true
          multipathd reconfigure 2>/dev/null || true
          ATTEMPTS=$((ATTEMPTS + 1))
          sleep 10
        done
        if [ -z "$DATA_DEV" ]; then
          echo "WARNING: data volume not found after $((MAX_ATTEMPTS * 10))s, using root filesystem" >&2
        else
          udevadm settle 2>/dev/null || true
          sleep 10
          # A device that is already mounted elsewhere belongs to an existing
          # storage layout. Mounting it again at /home would hide the root
          # filesystem's /home and add a second fstab entry, so leave the
          # host as it is. The directory is still created because cloud-init
          # runs restorecon on it after this service.
          DATA_MNT=$(lsblk -dnro MOUNTPOINT "$DATA_DEV" 2>/dev/null || true)
          if [ -n "$DATA_MNT" ]; then
            echo "WARNING: ${DATA_DEV} is already mounted at ${DATA_MNT}, leaving storage layout unchanged" >&2
            mkdir -p /home/containers/storage
            exit 0
          fi
          # Adopt an existing filesystem instead of reformatting it. The data
          # volume is blank on a fresh instance, but on a host whose storage
          # layout has drifted the mpath device can already hold live data
          # (for example podman storage) while /home is not a mountpoint.
          # Reformatting there would destroy that data, so only create a
          # filesystem when none is present.
          # Probe the device directly (-p bypasses the blkid cache, and reports
          # colliding signatures as exit 8 instead of hiding them). Exit 0 with
          # no TYPE means a signature other than a filesystem, such as a
          # partition table. Exit 2 means nothing was detected, but blkid also
          # returns it when the device cannot be read, so confirm the device is
          # readable before treating it as blank. Anything else leaves the
          # contents unknown, so stop rather than risk the device.
          BLKID_RC=0
          FS_TYPE=$(blkid -p -s TYPE -o value "$DATA_DEV" 2>/dev/null) || BLKID_RC=$?
          if [ "$BLKID_RC" -eq 0 ] && [ -z "$FS_TYPE" ]; then
            echo "ERROR: ${DATA_DEV} carries a non-filesystem signature, not formatting" >&2
            exit 1
          fi
          if [ "$BLKID_RC" -eq 2 ] && ! dd if="$DATA_DEV" of=/dev/null bs=4096 count=1 2>/dev/null; then
            echo "ERROR: ${DATA_DEV} is not readable, not formatting" >&2
            exit 1
          fi
          if [ "$BLKID_RC" -ne 0 ] && [ "$BLKID_RC" -ne 2 ]; then
            echo "ERROR: blkid failed on ${DATA_DEV} (exit ${BLKID_RC}), not formatting" >&2
            exit 1
          fi
          # Decide whether this volume may be used before touching it: a
          # filesystem created for a layout that is then rejected would be
          # left formatted but unused.
          UUID=$(blkid -p -s UUID -o value "$DATA_DEV" 2>/dev/null || true)
          # An fstab entry for this filesystem at another path is an existing
          # layout as well. Mounting at /home would not survive a reboot (fstab
          # would mount it at that path again), and rewriting the entry would
          # move live data, so leave the host as it is.
          FSTAB_TARGET=""
          if [ -n "$UUID" ]; then
            FSTAB_TARGET=$(awk -v u="UUID=${UUID}" '$1 == u {print $2; exit}' /etc/fstab 2>/dev/null || true)
          fi
          if [ -n "$FSTAB_TARGET" ] && [ "$FSTAB_TARGET" != /home ]; then
            echo "WARNING: fstab mounts UUID=${UUID} at ${FSTAB_TARGET}, leaving storage layout unchanged" >&2
            mkdir -p /home/containers/storage
            exit 0
          fi
          # Any other fstab entry for /home is an existing layout too. It can be
          # a different device, or a stale UUID from a volume that no longer
          # exists. In both cases appending our entry would leave two lines for
          # one mountpoint, so the boot-time result would depend on fstab order.
          FSTAB_HOME=""
          FSTAB_HOME=$(awk '$1 !~ /^#/ && $2 == "/home" {print $1; exit}' /etc/fstab 2>/dev/null || true)
          if [ -n "$FSTAB_HOME" ] && [ "$FSTAB_HOME" != "UUID=${UUID}" ]; then
            echo "WARNING: fstab already defines a /home entry (${FSTAB_HOME}), leaving storage layout unchanged" >&2
            mkdir -p /home/containers/storage
            exit 0
          fi
          if [ -z "$FS_TYPE" ]; then
            mkfs.xfs -f -K "$DATA_DEV"
            FS_TYPE=xfs
            FRESH_FS=1
          else
            echo "Adopting existing ${FS_TYPE} filesystem on ${DATA_DEV}" >&2
          fi
          # Migrate the root filesystem's /home only onto a volume this script
          # just created. On an adopted volume the same copy would overwrite
          # paths that already hold live data.
          if [ "$FRESH_FS" -eq 1 ]; then
            mkdir -p /mnt/home-tmp
            cp -a /home/. /mnt/home-tmp/
          fi
          mount "$DATA_DEV" /home
          # mkfs.xfs writes the UUID at format time, so on a fresh volume the
          # probe above ran before any UUID existed and returned nothing.
          # Re-read it now that the filesystem is created and mounted, or the
          # fstab entry below is skipped and /home stays unmounted at boot
          # until this service runs again.
          UUID=$(blkid -p -s UUID -o value "$DATA_DEV" 2>/dev/null || true)
          if [ "$FRESH_FS" -eq 1 ]; then
            cp -a /mnt/home-tmp/. /home/
            rm -rf /mnt/home-tmp
          fi
          if [ -z "$UUID" ]; then
            echo "WARNING: no UUID for ${DATA_DEV}, skipping fstab entry" >&2
          elif [ "$FSTAB_TARGET" = /home ]; then
            echo "fstab already mounts UUID=${UUID} at /home, not adding another entry" >&2
          else
            echo "UUID=$UUID /home $FS_TYPE defaults 0 2" >> /etc/fstab
          fi
        fi
        mkdir -p /home/containers/storage
      fi
      if ! mountpoint -q /var/lib/containers/storage; then
        # Only bind when the graphroot directory lives on the root filesystem.
        # If it sits inside another mount (for example a data volume mounted at
        # /var/lib/containers) or the probe cannot tell, the bind would replace
        # a live store with an empty directory and force every image to be
        # pulled again, so fail closed.
        GRAPHROOT_MNT=$(findmnt -T /var/lib/containers/storage -no TARGET 2>/dev/null || true)
        if [ "$GRAPHROOT_MNT" = / ]; then
          mount --bind /home/containers/storage /var/lib/containers/storage
          if [ "$FRESH_FS" -eq 1 ]; then
            # Only authorize reset after binding the store created by this run.
            # A preserved graphroot may still contain live container data.
            touch /run/mount-data-home-fresh
          fi
        else
          echo "WARNING: /var/lib/containers/storage resolves to ${GRAPHROOT_MNT:-an unknown mount}, not binding over it" >&2
        fi
      fi
  - path: /etc/systemd/system/mount-data-home.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Mount data volume at /home

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/mount-data-home.sh
      RemainAfterExit=yes
      TimeoutStartSec=0

      [Install]
      WantedBy=multi-user.target
{{- if or .GitLabRunnerScript .GHActionsRunnerScript}}
  - path: /usr/local/sbin/reclaim-ipam.sh
    permissions: '0755'
    owner: root:root
    content: |
{{.ReclaimIPAMScript}}
  - path: /etc/systemd/system/reclaim-ipam.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Reclaim leaked netavark IP leases for the podman runner
      After=gitlab-runner.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/reclaim-ipam.sh
      Nice=10
      TimeoutStartSec=120
  - path: /etc/systemd/system/reclaim-ipam.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Periodic idle-safe netavark IP-lease reclamation

      [Timer]
      OnBootSec=5min
      OnUnitActiveSec=10min
      RandomizedDelaySec=90

      [Install]
      WantedBy=timers.target
{{- end}}
{{- if .OtelColScript}}
  - path: /opt/install-otelcol.sh
    permissions: '0700'
    owner: root:root
    content: |
{{.OtelColScript}}
{{- end}}
{{- if .GitLabRunnerScript}}
  - path: /etc/systemd/system/gitlab-runner.service.d/logging.conf
    permissions: '0644'
    content: |
      [Service]
      StandardOutput=append:/var/log/gitlab-runner/runner.log
      StandardError=append:/var/log/gitlab-runner/runner.log
      # Unlimited task/process ceiling so ccache->gcc->cc1->as chains during
      # compilation-heavy builds do not hit the systemd default TasksMax.
      TasksMax=infinity
  - path: /etc/logrotate.d/gitlab-runner
    permissions: '0644'
    content: |
      /var/log/gitlab-runner/runner.log {
          daily
          rotate 7
          compress
          delaycompress
          missingok
          notifempty
          copytruncate
      }
  - path: /opt/install-glrunner.sh
    permissions: '0700'
    owner: root:root
    content: |
{{.GitLabRunnerScript}}
{{- end}}
{{- if .GHActionsRunnerScript}}
  - path: /opt/install-ghrunner.sh
    permissions: '0700'
    owner: root:root
    content: |
{{.GHActionsRunnerScript}}
{{- end}}
runcmd:
  # sshd rejects even a key login once the unused password ages out, so turn
  # aging off for the login user.
  - chage -M -1 -I -1 -E -1 root
  - systemctl enable mount-data-home.service
  - dnf install -y git podman policycoreutils-python-utils
  - semanage fcontext -a -e /var/lib/containers/storage /home/containers/storage
  - |
    IFACE=$(ip route show default | awk '/default/ {print $5; exit}')
    ip route add 10.0.0.0/8 via {{.Gateway}} dev "$IFACE" 2>/dev/null || true
    echo "10.0.0.0/8 via {{.Gateway}}" > "/etc/sysconfig/network-scripts/route-$IFACE"
  - |
    if ! systemctl start mount-data-home.service; then
      echo "ERROR: mount-data-home.service failed; the data volume is not mounted and container storage would stay on the root disk. See: journalctl -u mount-data-home.service" >&2
      exit 1
    fi
  - restorecon -R /home/containers/storage
  - |
    if [ -f /run/mount-data-home-fresh ]; then
      podman system reset --force
    else
      echo "WARNING: skipping podman system reset; no fresh container store was bound" >&2
    fi
{{- if or .GitLabRunnerScript .GHActionsRunnerScript}}
  - systemctl daemon-reload
  - systemctl enable --now reclaim-ipam.timer
{{- end}}
{{- if .OtelColScript}}
  - bash /opt/install-otelcol.sh
{{- end}}
{{- if .GitLabRunnerScript}}
  - mkdir -p /var/log/gitlab-runner
  - bash /opt/install-glrunner.sh
{{- end}}
{{- if .GHActionsRunnerScript}}
  - |
    export COS_KEY_ID="{{ .COSAccessKeyID }}"
    export COS_SECRET="{{ .COSSecretAccessKey }}"
    export COS_ENDPOINT="{{ .COSEndpoint }}"
    bash /opt/install-ghrunner.sh
{{- end}}
